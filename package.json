{
  "name": "ledgerly",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @ledgerly/web",
    "appwrite:types": "appwrite types packages/core/src/generated/rows.ts --language ts --enum-style const"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
